# Your NVIDIA API key — get one free at build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Pick a model for each tier — any model from build.nvidia.com/models
# Opus  → your most powerful model (complex tasks)
# Sonnet → your balanced model (everyday coding)
# Haiku  → your fastest/cheapest model (quick tasks, background agents)
MODEL_OPUS=deepseek-ai/deepseek-v4-pro
MODEL_SONNET=deepseek-ai/deepseek-r1
MODEL_HAIKU=meta/llama-3.3-70b-instruct

# Proxy port (no need to change)
PORT=9090
